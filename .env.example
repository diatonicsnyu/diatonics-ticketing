# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. NEVER commit real keys.

# --- Supabase (Project Settings -> Data API / API Keys) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (starts with sb_publishable_). Safe for public reads; RLS limits it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (starts with sb_secret_). Server-only. Bypasses RLS. Keep private.
SUPABASE_SECRET_KEY=

# --- Site ---
# Where the site runs. Used to build links in emails (tickets).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (email) ---
# API key with Sending access (starts with re_). Server-only. Keep private.
RESEND_API_KEY=
# Sender. Leave blank until diatonics.therachelchen.com is verified in Resend (then
# Diatonics Tickets <tickets@diatonics.therachelchen.com>). Blank = Resend's test sender.
EMAIL_FROM=
# Where replies go (the sending address has no inbox), e.g. the group Gmail.
EMAIL_REPLY_TO=
# TEST MODE ONLY: every email goes here instead of to the buyer, because
# Resend only delivers to the account's own inbox until a domain is verified.
# Set it to the group Gmail. Delete it at go-live.
EMAIL_TEST_TO=

# --- Tickets ---
# Signs QR codes and "view my tickets" links. A long random string (at least
# 32 characters). Server-only. NEVER change it after tickets are sold: every
# ticket already sent would stop scanning.
TICKET_SECRET=

# --- Daily job (Vercel Cron, vercel.json) ---
# Vercel sends this with each daily run so nobody else can trigger it. A long
# random string (at least 32 characters). Server-only. Safe to change anytime.
CRON_SECRET=

# --- Stripe (Developers -> API keys; test mode until go-live) ---
# Publishable key (starts with pk_test_). Safe to be public.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (starts with sk_test_). Server-only. NEVER share or commit.
STRIPE_SECRET_KEY=
# Webhook signing secret (starts with whsec_). From Stripe: Developers -> Webhooks
# (or 'stripe listen' when testing locally). Server-only.
STRIPE_WEBHOOK_SECRET=

# Stripe restricted key (starts with rk_live_). NOT used by the site: kept here
# only for reference. The site uses STRIPE_SECRET_KEY. Server-only, keep private.
STRIPE_RESTRICTED_KEY=
