# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored. NEVER commit real keys.

# --- Supabase (Project Settings -> Data API / API Keys) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable" key (starts with sb_publishable_). Safe for public reads; RLS limits it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (starts with sb_secret_). Server-only. Bypasses RLS. Keep private.
SUPABASE_SECRET_KEY=

# --- Admin ---
# The ONE email allowed into /admin (must also exist as a user in Supabase Auth).
ADMIN_EMAIL=

# --- Site ---
# Where the site runs. Used to build links in emails (magic link, tickets).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (email) ---
# API key with Sending access (starts with re_). Server-only. Keep private.
RESEND_API_KEY=

# --- Stripe (Developers -> API keys; test mode until go-live) ---
# Publishable key (starts with pk_test_). Safe to be public.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (starts with sk_test_). Server-only. NEVER share or commit.
STRIPE_SECRET_KEY=
